# =============================================================================
# revit-starcoder-pipeline .gitignore
# =============================================================================

# --- Dataset directories (never commit scraped or processed data) ---
dataset

# --- API keys / secrets (never commit config with real keys) ---
# Commit config.py only as a template with YOUR_KEY placeholders
# If you use a secrets file instead, add it here:
.env
secrets.json

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# --- Virtual environments ---
venv/
.venv/
env/
.env/
ENV/

# --- Distribution / packaging ---
build/
dist/
*.egg-info/
*.egg
.eggs/

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- IDEs ---
.vscode/
.idea/
*.suo
*.user

# --- Logs ---
*.log
logs/

# --- Model weights / checkpoints (large files — use Git LFS if needed) ---
*.bin
*.safetensors
*.gguf
*.pt
*.ckpt
checkpoints/
starcoder2-revit-finetuned/
